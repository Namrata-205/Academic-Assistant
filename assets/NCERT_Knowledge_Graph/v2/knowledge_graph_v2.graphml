      <data key="d3">5.4 Prime Factorisation</data>
      <data key="d4">taught</data>
    </node>
    <node id="MATH6_C0138">
      <data key="d0">divisibility tests for 2, 5 and 10</data>
      <data key="d1">2, 5 और 10 से विभाज्यता की जाँच</data>
      <data key="d2">CH05</data>
      <data key="d3">5.5 Divisibility Tests</data>
      <data key="d4">taught</data>
    </node>
    <node id="MATH6_C0139">
      <data key="d0">divisibility tests for 4 and 8</data>
      <data key="d1">4 और 8 से विभाज्यता की जाँच</data>
      <data key="d2">CH05</data>
      <data key="d3">5.5 Divisibility Tests</data>
      <data key="d4">taught</data>
    </node>
    <edge source="MATH6_C0013" target="MATH6_C0036">
      <data key="d5">Whole numbers extend the counting numbers with 0.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0046" target="MATH6_C0047">
      <data key="d5">Subtraction is introduced as the inverse of addition.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0046" target="MATH6_C0102">
      <data key="d5">Multiplication is first understood as repeated addition.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0102" target="MATH6_C0103">
      <data key="d5">Division is the inverse of multiplication.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0037" target="MATH6_C0038">
      <data key="d5">A digit's value depends on its place.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0038" target="MATH6_C0101">
      <data key="d5">Comparing multi-digit numbers uses place value.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0013" target="MATH6_C0012">
      <data key="d5">Consecutive numbers follow one another in the counting order.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0002" target="MATH6_C0003">
      <data key="d5">Number patterns are a kind of pattern (1.2: patterns of numbers).</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0036" target="MATH6_C0003">
      <data key="d5">1.2 studies patterns in whole numbers 0, 1, 2, 3, ...</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0003" target="MATH6_C0005">
      <data key="d5">1.2: number sequences are the most basic type of number pattern.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0013" target="MATH6_C0006">
      <data key="d5">Odd numbers are every other counting number (Table 1).</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0013" target="MATH6_C0007">
      <data key="d5">Even numbers are every other counting number (Table 1).</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0005" target="MATH6_C0008">
      <data key="d5">Triangular numbers are presented as a sequence in Table 1.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0046" target="MATH6_C0008">
      <data key="d5">Triangular numbers are sums 1, 1+2, 1+2+3, ...</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0005" target="MATH6_C0009">
      <data key="d5">Squares are presented as a sequence in Table 1.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0102" target="MATH6_C0009">
      <data key="d5">A square number is a number multiplied by itself.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0005" target="MATH6_C0010">
      <data key="d5">Cubes are presented as a sequence in Table 1.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0102" target="MATH6_C0010">
      <data key="d5">A cube number is a number multiplied by itself three times.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0005" target="MATH6_C0011">
      <data key="d5">Powers of 2 are presented as a sequence in Table 1.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0102" target="MATH6_C0011">
      <data key="d5">Each power of 2 is the previous one multiplied by 2.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0005" target="MATH6_ADD001">
      <data key="d5">Virahānka numbers are presented as a sequence in Table 1.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0046" target="MATH6_ADD001">
      <data key="d5">Each Virahānka number is the sum of the previous two.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0005" target="MATH6_C0015">
      <data key="d5">1.3 draws pictures of the sequences listed in 1.2.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0008" target="MATH6_C0015">
      <data key="d5">1.3 asks why 1, 3, 6, 10, ... are called triangular, using pictures.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0009" target="MATH6_C0015">
      <data key="d5">1.3 explains square numbers with square dot arrays.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0015" target="MATH6_C0104">
      <data key="d5">Hexagonal numbers are named from their pictorial (hexagon) arrangement in 1.3.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0006" target="MATH6_C0105">
      <data key="d5">1.4: adding up odd numbers 1, 1+3, 1+3+5, ... gives squares.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0009" target="MATH6_C0105">
      <data key="d5">1.4 relations produce the square numbers.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0008" target="MATH6_C0105">
      <data key="d5">1.4: adding consecutive triangular numbers gives squares.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0015" target="MATH6_C0105">
      <data key="d5">1.4 explains each relation with a picture.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0002" target="MATH6_C0004">
      <data key="d5">1.5: patterns in shapes are the second kind of pattern.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0004" target="MATH6_C0014">
      <data key="d5">Regular polygons appear as a shape sequence in Table 3.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0004" target="MATH6_C0106">
      <data key="d5">Complete graphs appear as a shape sequence in Table 3.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0004" target="MATH6_C0107">
      <data key="d5">Stacked squares appear as a shape sequence in Table 3.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0009" target="MATH6_C0107">
      <data key="d5">1.6: counting little squares in stacked squares gives square numbers.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0004" target="MATH6_C0108">
      <data key="d5">Stacked triangles appear as a shape sequence in Table 3.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0008" target="MATH6_C0108">
      <data key="d5">1.6: rows of stacked triangles connect to triangular numbers.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0004" target="MATH6_C0109">
      <data key="d5">The Koch snowflake appears as a shape sequence in Table 3.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0102" target="MATH6_C0109">
      <data key="d5">1.6: segment counts 3, 12, 48, ... are 3 times powers of 4.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0016" target="MATH6_C0018">
      <data key="d5">2.2: a line segment is the shortest path between two points.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0018" target="MATH6_C0017">
      <data key="d5">2.3: a line is a segment extended endlessly in both directions.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0016" target="MATH6_C0019">
      <data key="d5">2.4: a ray starts at a point.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0017" target="MATH6_C0019">
      <data key="d5">2.4: a ray goes endlessly in one direction along a line.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0019" target="MATH6_C0020">
      <data key="d5">2.5: an angle is formed by two rays with a common starting point.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0020" target="MATH6_C0021">
      <data key="d5">2.5: the common starting point is called the vertex of the angle.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0016" target="MATH6_C0021">
      <data key="d5">The vertex is a point.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0020" target="MATH6_C0022">
      <data key="d5">2.5: the rays forming the angle are called its arms.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0019" target="MATH6_C0022">
      <data key="d5">The arms of an angle are rays.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0020" target="MATH6_C0110">
      <data key="d5">2.6 compares sizes of angles.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0021" target="MATH6_C0110">
      <data key="d5">Superimposing angles places vertex on vertex.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0022" target="MATH6_C0110">
      <data key="d5">Superimposing angles places one arm on another.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0020" target="MATH6_C0034">
      <data key="d5">2.7: the size of an angle is the amount of rotation of one arm.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0034" target="MATH6_C0023">
      <data key="d5">2.8: a straight angle is a half turn.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0017" target="MATH6_C0023">
      <data key="d5">The arms of a straight angle lie on one line.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0023" target="MATH6_C0024">
      <data key="d5">2.8: folding a straight angle into two equal angles gives right angles.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0024" target="MATH6_C0031">
      <data key="d5">2.8: lines that meet at right angles are perpendicular.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0017" target="MATH6_C0031">
      <data key="d5">Perpendicularity is a relation between lines.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0024" target="MATH6_C0025">
      <data key="d5">2.8: acute angles are smaller than a right angle.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0110" target="MATH6_C0025">
      <data key="d5">Classifying as acute requires comparing with a right angle.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0024" target="MATH6_C0026">
      <data key="d5">2.8: obtuse angles are greater than a right angle.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0023" target="MATH6_C0026">
      <data key="d5">2.8: obtuse angles are less than a straight angle.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0110" target="MATH6_C0026">
      <data key="d5">Classifying as obtuse requires comparing angles.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0034" target="MATH6_C0028">
      <data key="d5">A complete angle is one full turn of the rotating arm.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0023" target="MATH6_C0028">
      <data key="d5">Two straight angles make a full turn.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0028" target="MATH6_C0029">
      <data key="d5">2.9: a full turn is divided into 360 equal parts, each 1 degree.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0110" target="MATH6_C0035">
      <data key="d5">Bisecting (by folding) produces two equal angles.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0029" target="MATH6_C0035">
      <data key="d5">2.9 halves 90° to 45° and 22½° by folding.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0029" target="MATH6_C0030">
      <data key="d5">2.9: the protractor is the tool for measuring degrees.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0030" target="MATH6_C0111">
      <data key="d5">2.10 draws angles of a given measure with a protractor.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0029" target="MATH6_C0025">
      <data key="d5">2.11: acute angles measure more than 0° and less than 90°.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0029" target="MATH6_C0026">
      <data key="d5">2.11: obtuse angles measure more than 90° and less than 180°.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0029" target="MATH6_C0027">
      <data key="d5">2.11: reflex angles measure more than 180° and less than 360°.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0023" target="MATH6_C0027">
      <data key="d5">Reflex angles are greater than a straight angle.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0028" target="MATH6_C0027">
      <data key="d5">Reflex angles are less than a complete angle.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0101" target="MATH6_C0051">
      <data key="d5">3.2: a supercell holds a number larger than all its neighbours.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0101" target="MATH6_C0041">
      <data key="d5">3.3 places numbers on a number line in order.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0038" target="MATH6_C0041">
      <data key="d5">Placing 2180, 2754, ... between marked thousands uses place value.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0037" target="MATH6_C0039">
      <data key="d5">A digit sum adds the digits of a number.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0046" target="MATH6_C0039">
      <data key="d5">A digit sum is computed by addition.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0037" target="MATH6_C0040">
      <data key="d5">A palindrome reads the same digits left-to-right and right-to-left.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0046" target="MATH6_C0040">
      <data key="d5">3.5: reverse-and-add produces palindromes.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0101" target="MATH6_C0050">
      <data key="d5">Kaprekar's routine forms the largest and smallest numbers from the digits.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0047" target="MATH6_C0050">
      <data key="d5">Kaprekar's routine subtracts the smallest from the largest.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0040" target="MATH6_C0112">
      <data key="d5">3.7 looks for palindromic dates and times.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0037" target="MATH6_C0112">
      <data key="d5">Clock and calendar puzzles rearrange digits.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0046" target="MATH6_C0113">
      <data key="d5">3.8 composes numbers mentally by addition.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0047" target="MATH6_C0113">
      <data key="d5">3.8 also uses subtraction.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0038" target="MATH6_C0113">
      <data key="d5">Mental math in 3.8 works with hundreds and thousands.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0003" target="MATH6_C0049">
      <data key="d5">3.9 uses arrangements/patterns of numbers to find sums quickly.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0113" target="MATH6_C0049">
      <data key="d5">3.9 replaces one-by-one addition by quicker mental methods.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0005" target="MATH6_ADD002">
      <data key="d5">A Collatz sequence is a number sequence produced by a rule.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0006" target="MATH6_ADD002">
      <data key="d5">The Collatz rule multiplies odd numbers by 3 and adds 1.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0007" target="MATH6_ADD002">
      <data key="d5">The Collatz rule halves even numbers.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0102" target="MATH6_ADD002">
      <data key="d5">The odd step multiplies by 3.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0038" target="MATH6_C0042">
      <data key="d5">Estimates are made to the nearest ten, hundred, thousand.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0113" target="MATH6_C0042">
      <data key="d5">Estimation relies on quick mental calculation.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0046" target="MATH6_C0114">
      <data key="d5">3.12 games add 1, 2 or 3 to the previous number.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0003" target="MATH6_C0114">
      <data key="d5">The winning strategy is a pattern of numbers to say.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0115" target="MATH6_C0116">
      <data key="d5">4.1 records collected data with tally marks.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0115" target="MATH6_C0117">
      <data key="d5">Frequencies are counts of occurrences of data values.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0013" target="MATH6_C0117">
      <data key="d5">A frequency is a count.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0116" target="MATH6_C0118">
      <data key="d5">A frequency table is filled using tally marks.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0117" target="MATH6_C0118">
      <data key="d5">A frequency table lists the frequency of each category.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0117" target="MATH6_C0119">
      <data key="d5">A pictograph shows the frequency of each category with pictures.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0119" target="MATH6_C0120">
      <data key="d5">4.2 introduces the scale/key when one symbol stands for many students.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0102" target="MATH6_C0120">
      <data key="d5">Reading a scaled pictograph multiplies symbols by the scale (5 × 10 = 50).</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0117" target="MATH6_C0121">
      <data key="d5">The length or height of a bar gives the frequency.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0119" target="MATH6_C0121">
      <data key="d5">4.3: "Like pictographs, bar graphs..."</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0120" target="MATH6_C0121">
      <data key="d5">4.3 bar graphs use a scale when frequencies are large.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0121" target="MATH6_C0122">
      <data key="d5">4.4 draws the bar graph introduced in 4.3.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0118" target="MATH6_C0122">
      <data key="d5">4.4 starts from Shri Nilesh's frequency table.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0031" target="MATH6_C0122">
      <data key="d5">4.4: "Draw two perpendicular lines, one horizontal and one vertical."</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0121" target="MATH6_C0123">
      <data key="d5">4.5 chooses vertical (column) or horizontal bars.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0121" target="MATH6_C0124">
      <data key="d5">4.5: infographics are beautified bar graphs.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0102" target="MATH6_C0125">
      <data key="d5">Multiples of 3 are 3 × 1, 3 × 2, 3 × 3, ...</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0125" target="MATH6_C0126">
      <data key="d5">5.1: numbers that are multiples of both 3 and 5 are common multiples.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0103" target="MATH6_C0127">
      <data key="d5">5.1: factors divide a number exactly.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0125" target="MATH6_C0127">
      <data key="d5">Jump sizes that land on 24 are its factors (24 is their multiple).</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0127" target="MATH6_C0128">
      <data key="d5">5.1: jump sizes reaching both treasures are common factors.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0127" target="MATH6_C0129">
      <data key="d5">A perfect number's factors sum to twice the number.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0046" target="MATH6_C0129">
      <data key="d5">Perfect numbers are checked by adding the factors.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0127" target="MATH6_C0130">
      <data key="d5">5.2: primes have exactly two factors.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0127" target="MATH6_C0131">
      <data key="d5">5.2: composite numbers have more than two factors.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0130" target="MATH6_C0132">
      <data key="d5">The sieve circles primes.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0131" target="MATH6_C0132">
      <data key="d5">The sieve crosses out composites.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0125" target="MATH6_C0132">
      <data key="d5">The sieve crosses out all multiples of each prime.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0130" target="MATH6_C0133">
      <data key="d5">Twin primes are pairs of primes.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0128" target="MATH6_C0134">
      <data key="d5">5.3: co-prime numbers have no common factor other than 1.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0130" target="MATH6_C0135">
      <data key="d5">5.4: prime factorisation writes a number as a product of primes.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0131" target="MATH6_C0135">
      <data key="d5">5.4 keeps breaking composite factors until only primes are left.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0102" target="MATH6_C0135">
      <data key="d5">A factorisation is a product.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0135" target="MATH6_C0136">
      <data key="d5">5.4: "The individual factors are called prime factors."</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0103" target="MATH6_C0137">
      <data key="d5">5.4: 48 is divisible by 12 because the remainder is zero.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0127" target="MATH6_C0137">
      <data key="d5">"If a number is divisible by another, the second is a factor of the first."</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0137" target="MATH6_C0138">
      <data key="d5">5.5 tests divisibility without long division.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0125" target="MATH6_C0138">
      <data key="d5">The tests come from patterns in the last digit of multiples of 10, 5, 2.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0007" target="MATH6_C0138">
      <data key="d5">Numbers divisible by 2 are the even numbers (end in 0, 2, 4, 6, 8).</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0038" target="MATH6_C0139">
      <data key="d5">Only the last two/three places matter for divisibility by 4/8.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">definitional</data>
    </edge>
    <edge source="MATH6_C0138" target="MATH6_C0139">
      <data key="d5">5.5: the last-digit rule fails for 4, so more digits are examined.</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
    <edge source="MATH6_C0136" target="MATH6_C0134">
      <data key="d5">5.4: no common prime factor ⇔ co-prime (systematic check).</data>
      <data key="d6">PENDING_HUMAN_REVIEW</data>
      <data key="d7">section reference</data>
    </edge>
  </graph>
</graphml>