  <data key="d7">CH02_EN_PDF001_B002;CH02_EN_PDF005_B004</data>
</edge>
<edge source="MATH6_C0018" target="MATH6_C0022">
  <data key="d4">0.73</data>
  <data key="d5">Understanding a line segment helps learners grasp the notion of a straight connection between two points, a prerequisite for recognizing the ‘arms’ (rays) of an angle.</data>
